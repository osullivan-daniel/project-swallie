{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "frontend-admin",
  "projectType": "application",
  "sourceRoot": "apps/frontend-admin/src",
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "options": {
        "outputPath": {
          "base": "dist/frontend-admin"
        },
        "index": "apps/frontend-admin/src/index.html",
        "browser": "apps/frontend-admin/src/main.ts",
        "polyfills": [
          "apps/frontend-admin/src/polyfills.ts"
        ],
        "tsConfig": "apps/frontend-admin/tsconfig.app.json",
        "styles": [
          "apps/frontend-admin/src/styles.css"
        ],
        "scripts": [],
        "extractLicenses": false,
        "sourceMap": true,
        "optimization": false,
        "namedChunks": true,
        "assets": []
      },
      "outputs": [
        "{options.outputPath.base}"
      ]
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "buildTarget": "frontend-admin:build",
        "port": 4201
      }
    }
  }
}
